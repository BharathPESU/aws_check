# Server Port
PORT=5000

# AWS Region & S3 Bucket Configuration
# For production EC2 deployment, use IAM Role attached to the EC2 instance for AWS credentials!
# Local development can also use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if not using an IAM role.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=maya-monitor-iot-images-ap-south-1

# PostgreSQL RDS Connection String
# Format: postgresql://<USERNAME>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DATABASE_NAME>
DATABASE_URL=postgresql://maya_admin:YourSecurePassword123@maya-postgres-db.c123456789.ap-south-1.rds.amazonaws.com:5432/maya_monitor

# Client CORS Origin (Allow React frontend)
CLIENT_ORIGIN=http://localhost:3000
